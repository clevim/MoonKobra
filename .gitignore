.env
__pycache__/
*.pyc
build/
dist/
*.spec
releases/

!moonkobra.spec

# Dados de execução e credenciais da impressora — nunca commitar
config/config.ini
config/*.ini
!config/config.ini.example
data/*

!data/orca_filaments.json
.runner-token

# Arquivos só de desenvolvimento — fora do repositório público
CLAUDE.md
.claude/
agents.md
.impeccable/
DESIGN.md
PRODUCT.md
web/DOC/
release.sh

# Certificado que a impressora entrega (config/certs/) e os antigos do slicer.
config/certs/
anycubic_slicer.crt
anycubic_slicer.key

# Rede de segurança: nenhum certificado/chave privada deve ir ao repo, em pasta alguma.
*.crt
*.key
*.pem

# venv local
.venv/
.pytest_cache/

# Testes — só desenvolvimento local, fora do repositório público
tests/
pytest.ini
requirements-test.txt

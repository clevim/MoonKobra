# MoonKobra – parâmetros de conexão (modo antigo, opcional)
# Hoje o normal é adicionar a impressora pela interface ("Adicionar impressora"),
# que grava tudo em config/config.ini. Este arquivo só serve para rodar sem
# interface: copie para .env e preencha. O .env nunca vai para o repositório.
#   cp .env.example .env
#
# As credenciais saem de: python fetch_credentials.py --ip <IP> --write-config

# IP da impressora na rede local
PRINTER_IP=192.168.x.x

# Porta MQTT (padrão da Anycubic Kobra X: 9883)
MQTT_PORT=9883

# Credenciais MQTT (de cada impressora, começa com "user")
MQTT_USERNAME=userXXXXXXXXXX
MQTT_PASSWORD=XXXXXXXXXXXXXXX

# ID do dispositivo (32 caracteres hexadecimais, de cada impressora)
DEVICE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ID do modelo (padrão da Kobra X: 20030)
MODE_ID=20030
